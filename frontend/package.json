{
  "name": "bran-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:fast": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "gen:types": "openapi-typescript http://127.0.0.1:8765/openapi.json -o src/lib/api-types.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/prismjs": "^1.26.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "jsdom": "^24.1.3",
    "openapi-typescript": "^7.6.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.30.1",
    "svelte-check": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.3.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@fontsource/source-serif-4": "^5.3.0",
    "dompurify": "^3.4.12",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "prismjs": "^1.30.0"
  }
}
