# Anthropic API key — required. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# Bearer token used by the HTTP server to authenticate inbound requests.
# Generate any high-entropy string (e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
BRAN_API_TOKEN=replace-me-with-a-long-random-string

# Where bran stores its SQLite DB and scheduler state. Defaults to ./.bran/
# BRAN_HOME=./.bran

# Host/port for `bran serve`. Default is localhost-only.
# BRAN_HOST=127.0.0.1
# BRAN_PORT=8765

# Default model alias used by agents that don't pin one (sonnet | opus | haiku).
# BRAN_DEFAULT_MODEL=sonnet

# --- External MCP servers (auto-enabled when key is set) ---
# Tavily: better web search & content extraction for the research agent.
# Get a key at https://tavily.com (free tier is generous).
# When set, the research agent + research subagent get tools
# mcp__tavily__tavily_search / _extract / _map / _crawl, and prefer them
# over the SDK's built-in WebSearch / WebFetch.
# TAVILY_API_KEY=tvly-...

# --- Notifications (optional) ---
# Set either of these to be notified when an agent run completes.
#
# POST the run record as JSON to this URL on every completion. Works with
# ntfy.sh, Slack/Discord webhooks, or your own endpoint. Example:
# BRAN_NOTIFY_WEBHOOK_URL=https://ntfy.sh/bran-ioan-private-topic
#
# Beep + print a one-line summary to stderr when a run finishes.
# BRAN_NOTIFY_BELL=1
